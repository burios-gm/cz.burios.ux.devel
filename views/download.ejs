<!DOCTYPE html>
<html lang="cs">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
	
		<title><%= appTitle %></title>

		<link rel="icon" href="/devel/favicon.png">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" type="text/css" media="all" />
		<link rel="stylesheet" href="/devel/libs/qpx/themes/jquery.qpx.default.css?build=<%= timeNo %>" type="text/css">
		<link rel="stylesheet" href="/devel/api/qpx-test.css?build=<%= timeNo %>">

		<style type="text/css">
		html, body {
			font-family: "Segoe UI", Arial, sans-serif;
			font-size: 13px;
			margin: 0;
			padding: 24px;
			background: #f4f6f8;
		}
		.card-container {
			background: #fff;
			max-width: 540px;
			border-radius: 8px;
			border: 1px solid #e2e6ea;
			padding: 24px;
			box-shadow: 0 2px 8px rgba(0,0,0,0.05);
		}
		.qpx-back-home {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			text-decoration: none;
			color: #337ab7;
			margin-bottom: 16px;
			font-size: 13px;
		}
		input[type="text"] {
			padding: 8px 12px;
			border: 1px solid #ccc;
			border-radius: 4px;
			font-size: 13px;
			width: 60%;
		}
		button {
			padding: 8px 16px;
			background: #337ab7;
			color: #fff;
			border: none;
			border-radius: 4px;
			cursor: pointer;
		}
		button:hover {
			background: #286090;
		}
		</style>
		<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	</head>
	<body>
		<div class="card-container">
			<a href="/devel/" class="qpx-back-home"><i class="fa fa-arrow-left"></i> Zpět na rozcestník QPX</a>
			<h1 style="font-size: 20px; margin-top: 0;">Stáhnout soubor (AJAX)</h1>
			<p style="color: #666; margin-bottom: 20px;">Zadejte název souboru pro vyhledání a stažení ze serverového úložiště.</p>

			<form id="downloadForm" style="display: flex; gap: 8px; align-items: center;">
				<input type="text" id="filename" name="filename" placeholder="např. sample_doc.pdf"/>
				<button type="submit">Stáhnout</button>
			</form>

			<div id="result" style="margin-top: 16px;"></div>
		</div>

		<script>
		$(function() {
			$("#downloadForm").on("submit", function(e) {
				e.preventDefault();
				var filename = $("#filename").val().trim();
				if (!filename) {
					$("#result").html("<p style='color:#d9534f'>Zadejte název souboru.</p>");
					return;
				}
				$.ajax({
					url: "/downloadFile",
					type: "GET",
					data: { filename: filename },
					xhrFields: { responseType: 'blob' },
					success: function(blob, status, xhr) {
						var disposition = xhr.getResponseHeader('Content-Disposition');
						var downloadName = filename;
						if (disposition && disposition.indexOf('filename=') !== -1) {
						    downloadName = disposition.split('filename=')[1].replace(/"/g, '');
						}
						var url = window.URL.createObjectURL(blob);
						var a = document.createElement('a');
						a.href = url;
						a.download = downloadName;
						document.body.appendChild(a);
						a.click();
						a.remove();
						window.URL.revokeObjectURL(url);
						$("#result").html("<p style='color:#5cb85c'>Soubor " + downloadName + " úspěšně stažen.</p>");
		            },
		            error: function(xhr) {
		                $("#result").html("<p style='color:#d9534f'>Chyba: " + (xhr.responseText || "Soubor nebyl nalezen") + "</p>");
		            }
				});
			});
		});
		</script>
	</body>
</html>
