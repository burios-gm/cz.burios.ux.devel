<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	
	<title><%= appTitle %></title>
	<link rel="icon" href="/devel/favicon.png">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" type="text/css" media="all" />
	
	<style type="text/css">
	html, body {
		font-family: "Segoe UI", Arial, sans-serif;
		font-size: 13px;
		margin: 0;
		padding: 24px;
		background: #f4f6f8;
	}
	.container {
		background: #fff;
		border-radius: 8px;
		border: 1px solid #e2e6ea;
		padding: 24px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.05);
		max-width: 800px;
	}
	table { 
		border-collapse: collapse; width: 100%; margin-top: 16px;
	}
	th, td { 
		border: 1px solid #e2e6ea; padding: 10px 12px; text-align: left; 
	}
	th {
		background: #f8fafc;
		font-weight: 600;
	}
	img.thumbnail { 
		width: 32px; height: 32px; border-radius: 4px; object-fit: cover; aspect-ratio: 1 / 1; display: block;
	}
	.download-icon { 
		width: 24px; height: 24px; cursor: pointer; display: inline-block;
	}
	.qpx-back-home {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		text-decoration: none;
		color: #337ab7;
		margin-bottom: 16px;
		font-size: 13px;
	}
	button {
		padding: 6px 14px;
		background: #337ab7;
		color: #fff;
		border: none;
		border-radius: 4px;
		cursor: pointer;
	}
	button:hover {
		background: #286090;
	}
	</style>
	<script type="text/javascript" src="/devel/libs/jquery/jquery-3.7.1.js"></script>
</head>
<body>
	<div class="container">
		<a href="/devel/" class="qpx-back-home"><i class="fa fa-arrow-left"></i> Zpět na rozcestník QPX</a>
		<h2 style="margin-top: 0;">Buriosca.cz - Darwin QPX - FileManager</h2>
		
		<form id="uploadForm" enctype="multipart/form-data" style="display: flex; gap: 8px; align-items: center; margin-bottom: 20px;">
			<input type="file" name="file" id="fileInput"/>
			<button type="submit">Upload souboru</button>
		</form>
		<div id="uploadMsg" style="margin-bottom: 12px;"></div>
		
		<table id="fileTable">
			<thead>
				<tr>
					<th style="width: 50px;">Typ</th>
					<th>Název souboru</th>
					<th style="width: 90px; text-align: center;">Download</th>
				</tr>
			</thead>
			<tbody>
				<% files.forEach(function(file) { %>
					<tr id="<%= file.id %>">
						<td>
							<i class="fa fa-file-o" style="font-size: 24px; color: #337ab7;"></i>
						</td>
						<td><%= file.fileName %></td>
						<td style="text-align: center;">
							<a href="/darwin/files/download?fileId=<%= file.id %>" class="download-link" title="Stáhnout <%= file.fileName %>" style="color: #337ab7; text-decoration: none; font-size: 18px;">
								<i class="fa fa-download"></i>
							</a>
						</td>
					</tr>
				<% }); %>
			</tbody>
		</table>
	</div>

	<script>
	$(function() {
		$("#uploadForm").on("submit", function(e) {
			e.preventDefault();
			var fileInput = document.getElementById("fileInput");
			if (!fileInput.files.length) {
				$("#uploadMsg").html("<span style='color:#d9534f'>Vyberte soubor pro nahrání.</span>");
				return;
			}
			let formData = new FormData(this);
			$.ajax({
				url: "/darwin/files/ajax/upload",
				type: "POST",
				data: formData,
				processData: false,
				contentType: false
			}).done(function(file) {
				let row = "" +
					"<tr id='" + file.id + "'>" +
						"<td><i class='fa fa-file-o' style='font-size: 24px; color: #337ab7;'></i></td>" +
						"<td>" + file.fileName + "</td>" +
						"<td style='text-align: center;'>" +
							"<a href='/darwin/files/download?fileId=" + file.id + "' class='download-link' style='color: #337ab7; font-size: 18px;'>" +
								"<i class='fa fa-download'></i>" +
							"</a>" +
						"</td>" +
					"</tr>";
				$("#fileTable tbody").append(row);
				$("#uploadMsg").html("<span style='color:#5cb85c'>Soubor " + file.fileName + " byl úspěšně nahrán.</span>");
				fileInput.value = "";
			}).fail(function(xhr) {
				$("#uploadMsg").html("<span style='color:#d9534f'>Chyba při uploadu: " + xhr.responseText + "</span>");
			});
		});
	});
    </script>		
</body>
</html>
