<project name="cz.burios.ux.devel" basedir="." default="archive.src">

	<property name="project.home" value="${basedir}" />
	<property name="archive.home.default" value="e:/backup/projects/JS/github/buriosca/gmail/" />
	<property name="archive.home.nb" value="d:/DATA/Google/Projekty/java/projects/github/buriosca/gmail/" />
	<property name="archive.home.home" value="d:/DATA/Google/Projekty/java/projects/github/buriosca/gmail/" />
	<property name="archive.home.work" value="c:/DATA/Google/Projekty/java/projects/github/buriosca/gmail/" />
	<property name="project.root.dir" value="${project.home}" />

	<!-- Check timestamp on files -->
	<target name="prepare">
		<tstamp>
			<format property="date" pattern="yyyyMMddHHmm" />
		</tstamp>
	</target>

	<target name="archive.src" depends="prepare" description="Archivate source files">
		<zip destfile="${archive.home.default}/cz.burios.ux-devel-26.2-${date}.zip" basedir="${project.home}">
			<exclude name=".project" />
			<exclude name=".classpath" />
			<exclude name=".git/**" />
			<exclude name=".settings/**" />
			<exclude name="node_modules/**" />
			<exclude name="target/**" />
		</zip>
	</target>
	<target name="archive.src.home" depends="prepare" description="Archivate source files">
		<zip destfile="${archive.home.home}/cz.burios.ux-devel-26.2-${date}.zip" basedir="${project.home}">
			<exclude name=".project" />
			<exclude name=".classpath" />
			<exclude name=".git/**" />
			<exclude name=".settings/**" />
			<exclude name="node_modules/**" />
			<exclude name="target/**" />
		</zip>
	</target>
	<target name="archive.src.work" depends="prepare" description="Archivate source files">
		<zip destfile="${archive.home.work}/cz.burios.ux-devel-26.2-${date}.zip" basedir="${project.home}">
			<exclude name=".project" />
			<exclude name=".classpath" />
			<exclude name=".git/**" />
			<exclude name=".settings/**" />
			<exclude name="node_modules/**" />
			<exclude name="target/**" />
		</zip>
	</target>
	
</project>